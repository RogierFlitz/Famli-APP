# Famli — environment variables

# =============================================================================
# DEMO MODE (local development without Supabase)
# =============================================================================
# Leave Supabase vars empty → Famli uses in-memory demo store + local accounts.
# Demo login buttons appear on /login only when these are unset.

# =============================================================================
# PRODUCTION (required)
# =============================================================================

# Supabase project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for browser — RLS enforces access)
# Legacy JWT format: eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alternative: Supabase publishable key (sb_publishable_...)
# Use ANON_KEY or PUBLISHABLE_KEY — either is accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL for auth redirects (password reset, email confirm)
# Production: https://your-domain.vercel.app
# Local with Supabase: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# PRODUCTION (required for guest links)
# =============================================================================

# Service role key — SERVER ONLY. Never expose via NEXT_PUBLIC_* or client code.
# Required for /invite/guest/[token] and ICS export (/api/calendar/feed/...)
# Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# CALENDAR INTEGRATIONS (optional — connect buttons work; sync needs these)
# =============================================================================

# Google Calendar OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph OAuth (Azure App Registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional — default "common" (work + personal Microsoft accounts)
MICROSOFT_TENANT_ID=common

# Server-only encryption for stored OAuth tokens / ICS URLs (recommended in production)
# CALENDAR_TOKEN_ENCRYPTION_KEY=

# OAuth redirect base — must match provider console callback URLs:
#   {NEXT_PUBLIC_SITE_URL}/api/calendar/google/callback
#   {NEXT_PUBLIC_SITE_URL}/api/calendar/microsoft/callback

# =============================================================================
# OPTIONAL
# =============================================================================

# NODE_ENV is set automatically by Vercel (production / development)

# =============================================================================
# INTERNAL ADMIN (optional)
# =============================================================================
# Staff roles live in public.admin_staff (not family_members).
# Run supabase/migrations/0013_admin_portal.sql and 0014_claim_first_super_admin.sql.
# First successful login on /admin becomes super_admin when the staff table is empty.
# Manual alternative: insert into public.admin_staff (user_id, role) values ('<auth uuid>', 'super_admin');
# Admin UI: /admin — never linked from the family app.
# Temporary first-access (remove after admin_staff is set):
# ADMIN_BOOTSTRAP_SECRET=  # min 16 characters, Vercel Production env only — never commit the value

