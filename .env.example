# Famli — lokale / Vercel env

# Zonder deze variabelen draait Famli op de lokale repository + demo-gezin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optioneel: canonical site URL voor wachtwoord-reset redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alleen server-side (admin/seed/migrations). NOOIT in browser of git.
# SUPABASE_SERVICE_ROLE_KEY=
